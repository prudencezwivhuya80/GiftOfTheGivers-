@{
    ViewData["Title"] = "Contact US";
}

<h1> Contact Us</h1>
<p class="lead"> Get in touch -we would love to hear from you. </p>

<div class="row">
    <div class="col-md-6">
        <h4>Our Details</h4>
        <p><strong>Email:</strong> info@gifftofgivers.org </p>
        <p><strong>Phone:</strong>0800 786 911</p>
        <p><strong>Address:</strong> 1188 Beitel Road ,Robertville</p>
        
    </div>

    <div class="col-md-6">
        <h4> Send a Message</h4>
        <form>
            <div class="mb-3">
                <label class="form-label">Your Name </label>
                <input type="text" class="form-control"/>

            </div>
       <div class="mb-3">
             <label class="form-label">Your Email</label>
             <input type="email" class="form-control" />
       </div>
       <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea class="form-control" rows="4"></textarea>

</div>
      <button type="submit" class="btn btn-primary"> Send Message</button>
            </form>
<div class="mt-4">
    <h4>Frequently Asked Questions</h4>
 
    <div class="mb-2">
        <button type="button" class="btn btn-light border w-100 text-start" onclick="toggleFaq('faq1')">
            How do I get a tax certificate for my donation?
        </button>
        <div id="faq1" style="display:none;" class="p-2 border-start">
            A certificate is generated automatically after you complete the donation form.
        </div>
    </div>
 
    <div class="mb-2">
        <button type="button" class="btn btn-light border w-100 text-start" onclick="toggleFaq('faq2')">
            Can I volunteer without donating?
        </button>
        <div id="faq2" style="display:none;" class="p-2 border-start">
            Yes, donating and volunteering are separate and you can do either one.
        </div>
    </div>
 
    <div class="mb-2">
        <button type="button" class="btn btn-light border w-100 text-start" onclick="toggleFaq('faq3')">
            How long does it take to hear back?
        </button>
        <div id="faq3" style="display:none;" class="p-2 border-start">
            We aim to respond to all queries within 48 hours.
        </div>
    </div>
</div>
 
<script>
    function toggleFaq(id) {
        var section = document.getElementById(id);
        if (section.style.display === "none") {
            section.style.display = "block";
        } else {
            section.style.display = "none";
        }
    }
</script>

    </div>
</div>